{
  "name": "team14-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_ENABLE_MSW=true vite",
    "typecheck": "tsc -b --pretty",
    "robots": "node scripts/generate-robots.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "seo:generate": "npm run robots && npm run sitemap",
    "build": "npm run seo:generate && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" \"src/**/__snapshots__/**/*.snap\" \"scripts/**/*.{js,mjs,cjs}\" \"*.config.{ts,js,mjs,cjs}\" vite.config.ts vitest.config.ts --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" \"src/**/__snapshots__/**/*.snap\" \"scripts/**/*.{js,mjs,cjs}\" \"*.config.{ts,js,mjs,cjs}\" vite.config.ts vitest.config.ts --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.2.0",
    "@tanstack/react-query": "^5.87.1",
    "axios": "^1.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.8.2",
    "react-toastify": "^11.0.5",
    "sockjs-client": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/react-query-devtools": "^5.87.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@typescript-eslint/utils": "^8.45.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.15",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
